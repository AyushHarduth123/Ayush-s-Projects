# Copy this file to .env and fill in your own values. .env is git-ignored.
NODE_ENV=development
PORT=4000
# MongoDB Atlas connection string, e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
# (leave out to use a local MongoDB at mongodb://127.0.0.1:27017 when seeding)
MONGO_URI=
MONGO_DBNAME=international-paymentsDB
# Any long random string, e.g. from: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# FRONTEND (React)
CLIENT_ORIGINS=https://localhost:5173,https://localhost:5174

# HTTPS FOR EXPRESS (set LOCAL_HTTPS=false to use plain HTTP)
# Create a local dev certificate with:
#   mkdir -p certs && openssl req -x509 -newkey rsa:2048 -nodes -days 365 -subj "/CN=localhost" \
#     -keyout certs/localhost.key -out certs/localhost.crt
LOCAL_HTTPS=true
SSL_KEY=./certs/localhost.key
SSL_CERT=./certs/localhost.crt
